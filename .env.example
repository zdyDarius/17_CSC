# ============ LLM（OpenAI 兼容端点） ============
LLM_MODEL=qwen-flash
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=30

# ============ 客服系统自有库（MySQL，异步 SQLAlchemy） ============
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/edu_cs?charset=utf8mb4

# ============ edu-data 业务服务（只调用 API，不直接写业务库） ============
EDU_API_BASE_URL=http://127.0.0.1:8000
EDU_API_TIMEOUT_SECONDS=10
EDU_API_GET_RETRIES=2

# ============ 只读订单明细适配器（补偿公开 API 缺口，仅 SELECT 白名单表） ============
EDU_READONLY_DB_URL=mysql+aiomysql://user:password@127.0.0.1:3306/edu?charset=utf8mb4

# ============ 服务 ============
APP_HOST=0.0.0.0
APP_PORT=18082

# ============ 知识库 ============
FAQ_FILE=knowledge_base/faq.json
DOCS_DIR=knowledge_base/documents

# ============ 会话与安全约束 ============
MAX_TEXT_LENGTH=2000
MAX_HISTORY_TURNS=12
MAX_PAUSED_TASKS=5
